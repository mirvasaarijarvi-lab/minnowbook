{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "predev": "bunx tsx scripts/generate-sitemap.ts",
    "dev": "vite dev",
    "prebuild": "bunx tsx scripts/generate-sitemap.ts",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "lint:blog-jsonld": "bun run scripts/ci/lint-blog-jsonld.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:offer-kitchen": "vitest run --reporter=default --reporter=json --outputFile=offer-kitchen-report/report.json src/lib/offer-kitchen-mapping.test.ts src/lib/offer-kitchen-preview.test.ts src/lib/offer-kitchen-orders.test.ts src/lib/offer-kitchen-consistency.test.ts src/lib/offer-kitchen-message.test.ts src/components/dashboard/OfferCreateDialog.kitchenMapping.test.tsx src/components/dashboard/OffersManager.kitchenOrders.test.tsx",
    "test:security": "vitest run --config vitest.security.config.ts --reporter=verbose",
    "test:security:live": "vitest run --config vitest.security-live.config.ts --reporter=verbose",
    "test:security:billing": "node scripts/run-billing-hardening-tests.mjs",
    "test:security:billing:roles": "node scripts/run-billing-hardening-tests.mjs --suite=roles",
    "test:rls-report": "vitest run --config vitest.security-live.config.ts --testTimeout=120000 --hookTimeout=120000 --reporter=default --reporter=./src/test/security/rls-report-reporter.ts src/test/security/cross-tenant-rls.test.ts src/test/security/cross-tenant-storage.test.ts src/test/security/tenant-table-manifest.test.ts",
    "test:rls-report:core": "vitest run --config vitest.security-live.config.ts --testTimeout=120000 --hookTimeout=120000 --reporter=default --reporter=./src/test/security/rls-report-reporter.ts src/test/security/cross-tenant-rls.test.ts src/test/security/tenant-table-manifest.test.ts",
    "test:rls-report:storage-baseline": "vitest run --config vitest.security-live.config.ts --testTimeout=120000 --hookTimeout=120000 --reporter=default --reporter=./src/test/security/rls-report-reporter.ts src/test/security/cross-tenant-storage.test.ts -t \"Anonymous client storage enforcement|Live cross-tenant storage denial|Anonymous client nested-path enforcement\"",
    "test:rls-report:storage-nested-private": "vitest run --config vitest.security-live.config.ts --testTimeout=120000 --hookTimeout=120000 --reporter=default --reporter=./src/test/security/rls-report-reporter.ts src/test/security/cross-tenant-storage.test.ts -t \"Live cross-tenant nested-path denial.*tenant-private|Live cross-tenant nested-path denial.*sanity|Live cross-tenant nested-path denial.*DOWNLOAD|Live cross-tenant nested-path denial.*LIST|Live cross-tenant nested-path denial.*DELETE\"",
    "test:rls-report:storage-nested-assets": "vitest run --config vitest.security-live.config.ts --testTimeout=120000 --hookTimeout=120000 --reporter=default --reporter=./src/test/security/rls-report-reporter.ts src/test/security/cross-tenant-storage.test.ts -t \"Live cross-tenant nested-path denial.*tenant-assets\"",
    "test:rls-report:storage-adversarial": "vitest run --config vitest.security-live.config.ts --testTimeout=120000 --hookTimeout=120000 --reporter=default --reporter=./src/test/security/rls-report-reporter.ts src/test/security/cross-tenant-storage.test.ts -t \"adversarial path normalization|victim tenant_id in later path segments\"",
    "test:rls-report:storage-assets": "vitest run --config vitest.security-live.config.ts --testTimeout=120000 --hookTimeout=120000 --reporter=default --reporter=./src/test/security/rls-report-reporter.ts src/test/security/cross-tenant-storage.test.ts -t \"tenant-assets public bucket: cross-tenant list/download isolation|tenant-assets: cross-tenant existence-probe denial|tenant-assets: path-traversal bypass denial|tenant-assets: public CDN read works, anon enumeration denied\"",
    "test:rls-report:storage-multipart": "vitest run --config vitest.security-live.config.ts --testTimeout=120000 --hookTimeout=120000 --reporter=default --reporter=./src/test/security/rls-report-reporter.ts src/test/security/cross-tenant-storage.test.ts -t \"multipart|Multipart\"",
    "e2e:install": "playwright install chromium",
    "e2e": "playwright install chromium && playwright test",
    "e2e:ui": "playwright install chromium && playwright test --ui",
    "test:ci": "bash scripts/test-ci.sh",
    "check:permission-arity": "node scripts/ci/check-permission-arity.mjs",
    "check:actions": "node scripts/ci/check-action-versions.mjs",
    "check:actions:fix": "node scripts/ci/check-action-versions.mjs --fix",
    "secrets:list": "node scripts/ci/secret-rotation.mjs --list",
    "secrets:rotate": "node scripts/ci/secret-rotation.mjs",
    "secrets:check": "node scripts/ci/secret-rotation.mjs --check",
    "check:rls-cors-gate": "node scripts/ci/check-rls-cors-gate-config.mjs",
    "check:rls-cors-gate:dry-run": "node scripts/ci/rls-cors-gate-preflight.mjs --dry-run",
    "check:lockfile": "node scripts/ci/preflight-manifest-drift.mjs",
    "check:lockfile:npm": "node scripts/ci/check-npm-lockfile-hygiene.mjs",
    "lock:heal": "node scripts/ci/heal-bun-lockfile.mjs",
    "lock:heal:check": "node scripts/ci/heal-bun-lockfile.mjs --check",
    "prepare": "node scripts/setup-git-hooks.mjs",
